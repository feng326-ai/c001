!wxsearch/config/wx_search.db
# schema 定义保留
!docs/*.sql

# 密钥/敏感配置（页面填写的 API 密钥存这里，绝不入库）
wxsearch/config/secrets.json

# Redis dump
*.rdb

# 其他临时文件
*.tmp
temp/
.cache/

# Git 属性必须入库，用来冻结迁移 SQL 的 LF 换行。
