# 复制为 .env 后填写真实值；.env 永不提交。
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
SESSION_SECRET=replace-with-a-long-random-session-secret

# AI 通用配置
AI_ENABLED=true
AI_BACKEND=rule
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=

# LLM 清洗只允许一个环境开启：当前本地生产采集平面 true，云端正式业务平面 false。
LLM_CLEAN_ENABLED=false
LLM_CLEAN_BATCH=5
LLM_CLEAN_MAX_ATTEMPTS=3
LLM_CLEAN_BREAK_AFTER=3

# 本地生产采集库到正式业务库的单向同步；仅本地采集平面开启。
PROD_SYNC_ENABLED=false
PROD_SYNC_URL=
PROD_SYNC_SECRET=
PROD_SYNC_SOURCE=local-collector
PROD_SYNC_BATCH=100
PROD_SYNC_TIMEOUT=30

# 正式接收端与运维令牌
SYNC_SHARED_SECRET=
COLLECT_LOG_TOKEN=
ALERT_WEBHOOK_URL=
