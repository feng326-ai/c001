# 复制为 .env 后填写真实值；.env 永不提交。
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# 常驻 Backend/Worker/Beat 只能使用该非超级运行角色；先执行 provision 管理任务。
APP_DATABASE_USER=replace_with_runtime_role
APP_DATABASE_PASSWORD=replace-with-a-separate-runtime-password
REDIS_PASSWORD=replace-with-a-strong-redis-password
SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_COOKIE_SECURE=true

# 租户功能分阶段开关：当前均保持 false，禁止一次性全开。
TENANT_SESSION_BINDING_ENABLED=false
TENANT_SESSION_REQUIRED=false
TENANT_REVIEW_ENABLED=false
REVIEW_DISTRIBUTOR_ENABLED=false
# 独立 Distributor LOGIN 的 DSN；本批不接入常驻容器，保持为空。
DISTRIBUTOR_DATABASE_URL=
DISTRIBUTOR_DATABASE_USER=replace_with_distributor_role
DISTRIBUTOR_DATABASE_PASSWORD=replace-with-a-separate-distributor-password

# AI 通用配置
AI_ENABLED=true
AI_BACKEND=rule
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=

# LLM 清洗只允许一个环境开启：当前本地生产采集平面 true，云端正式业务平面 false。
LLM_CLEAN_ENABLED=false
LLM_CLEAN_BATCH=5
LLM_CLEAN_MAX_ATTEMPTS=3
LLM_CLEAN_BREAK_AFTER=3

# 本地生产采集库到正式业务库的单向同步；仅本地采集平面开启。
PROD_SYNC_ENABLED=false
PROD_SYNC_URL=
PROD_SYNC_SECRET=
PROD_SYNC_SOURCE=local-collector
PROD_SYNC_BATCH=100
PROD_SYNC_TIMEOUT=30

# 正式接收端与运维令牌
SYNC_SHARED_SECRET=
COLLECT_LOG_TOKEN=
ALERT_WEBHOOK_URL=
