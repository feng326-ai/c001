# 仅作字段模板；复制为服务器上的 .env.staging 后生成全新随机值并 chmod 0600。
# 密码建议使用 URL 安全的 32 字节十六进制字符串，避免连接串转义问题。
STAGING_POSTGRES_PASSWORD=replace-with-staging-only-hex-password
STAGING_APP_DATABASE_USER=replace_with_staging_runtime_role
STAGING_APP_DATABASE_PASSWORD=replace-with-staging-runtime-only-hex-password
STAGING_REDIS_PASSWORD=replace-with-staging-only-hex-password
STAGING_SESSION_SECRET=replace-with-staging-only-long-random-secret

# 必须使用当前已审核 Git 提交的短 SHA，禁止 latest。
APP_IMAGE_TAG=replace-with-git-sha
STAGING_BACKEND_PORT=18000
